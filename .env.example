GDA_ENVIRONMENT=local
GDA_ARTIFACT_ROOT=.artifacts
GDA_STATE_ROOT=.state
GDA_DEFAULT_MAX_RUNTIME_SECONDS=600
GDA_DEFAULT_MAX_SCAN_BYTES=10737418240
GDA_DEFAULT_MAX_TOKENS=30000

# Optional real-model integration through an existing CC Switch provider.
# Secrets are read at runtime and are never copied into this project.
GDA_CC_SWITCH_DB=~/.cc-switch/cc-switch.db
GDA_CC_SWITCH_APP_TYPE=claude
GDA_CC_SWITCH_PROVIDER=
GDA_LLM_TIMEOUT_SECONDS=120
